# Build stage
FROM golang:1.23-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum* ./
RUN go mod download || true

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/rudra-api ./cmd/rudra-api

# Final minimal runtime stage
FROM alpine:3.20

WORKDIR /app

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /bin/rudra-api /app/rudra-api
COPY config/ /app/config/

EXPOSE 8080

ENTRYPOINT ["/app/rudra-api"]

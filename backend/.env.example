# RudraNetra Backend Environment Configuration
RUDRA_SERVER_HOST=0.0.0.0
RUDRA_SERVER_PORT=8080
RUDRA_SERVER_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database (PostgreSQL + PostGIS + TimescaleDB)
RUDRA_DATABASE_HOST=localhost
RUDRA_DATABASE_PORT=5432
RUDRA_DATABASE_USER=rudra
RUDRA_DATABASE_PASSWORD=secretpassword
RUDRA_DATABASE_DBNAME=rudra_netra
RUDRA_DATABASE_SSLMODE=disable
RUDRA_DATABASE_MAX_CONNS=25
RUDRA_DATABASE_MIN_CONNS=5

# Redis
RUDRA_REDIS_ADDR=localhost:6379
RUDRA_REDIS_PASSWORD=
RUDRA_REDIS_DB=0

# NATS JetStream
RUDRA_NATS_URL=nats://localhost:4222

# JWT Security
RUDRA_JWT_SECRET=rudra-netra-super-secret-key-change-in-prod-min-32-chars
RUDRA_JWT_ACCESS_TOKEN_TTL=15m
RUDRA_JWT_REFRESH_TOKEN_TTL=720h

# Ingest TCP Server (GPS devices connect here)
RUDRA_INGEST_HOST=0.0.0.0
RUDRA_INGEST_PORT=5040
